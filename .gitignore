# Local Netlify folder
.netlify

# npm dependencies — devDependencies (e.g. jsdom, added 2026-08-04 for
# scripts/e2e-concert-radar.mjs) install locally via `npm install`, not
# committed; Netlify's own build only ever needs @netlify/blobs, which it
# installs itself from package.json.
node_modules

# Mac
.DS_Store

# Paste / base64 artifacts from chunked-paste deploys
*.b64

# One-shot deploy scripts — source of truth is git history, not the script
vs-deploy-*.sh

# One-shot migration / enrichment scripts — preserved locally, not in repo
cover-*.mjs
enrich.mjs
retry.mjs

# Local catalog exports and scratch notes
catalog.json
audit.txt

# Editor / tooling .bak files (e.g. netlify.toml.bak)
*.bak

# Pre-apply scratch snapshots — not the canonical daily backups
backups/pre-apply-*.json

# One-shot fix/enrichment scripts — preserved locally, not deployed (publish="." would otherwise serve these live)
enrich-release-info.py
fix-tosca-id.py
vinyl-scout-reseed.sh
vs-enrich-batch.py

# Quarantine for files the Cowork folder mount can't delete (rm is blocked
# there, so git locks and stray temp objects get moved here instead of
# removed). Never part of the repo. Added 2026-08-21 after an `add -A`
# swept 100+ of these in; travel-intelligence has ignored it since July.
_to_delete/
